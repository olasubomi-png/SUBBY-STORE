# =============================================================================
# SUBBY-STORE environment
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# development | production | test
NODE_ENV=development

# Public base URL (required in production). Used for Paystack callbacks.
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Required in production. Without DATABASE_URL in development, an in-memory
# store is used only when USE_MEMORY_DB=1 or during tests.
DATABASE_URL=postgresql://subby:subby@127.0.0.1:5432/subby_store

# Explicit memory DB for local/demo only (ignored / forbidden in production)
# USE_MEMORY_DB=1

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# Required. Minimum 32 random characters. Do not use placeholders in production.
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# -----------------------------------------------------------------------------
# Paystack
# -----------------------------------------------------------------------------
# Server-only secret. Never expose to the browser.
# In production: real sk_live_... or sk_test_... key (not a REPLACE placeholder).
PAYSTACK_SECRET_KEY=sk_test_REPLACE

# Optional public key for client widgets (V1 uses redirect flow)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE

# mock | live — mock is FORBIDDEN when NODE_ENV=production
# PAYSTACK_MODE=mock

# Vercel Blob (product images)
# BLOB_READ_WRITE_TOKEN=


# Optional: protect /api/cron/release-reservations (min 16 chars)
CRON_SECRET=
