# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://subby:subby@127.0.0.1:5432/subby_store

# Session (long random string)
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Paystack (never commit real secrets)
PAYSTACK_SECRET_KEY=sk_test_REPLACE
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE
